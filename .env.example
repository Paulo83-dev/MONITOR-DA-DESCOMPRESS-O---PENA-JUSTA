# Copie este arquivo para .env.local e preencha. NUNCA faça commit do .env.local.

# Banco de dados (Postgres). Na Vercel, conectar o Neon pelo Marketplace cria
# a variável DATABASE_URL sozinha. Sem ela, o site roda em desenvolvimento com
# um banco local em arquivo (PGlite) e, em produção, esconde contador e fórum.
DATABASE_URL=

# Segredos do servidor (use valores longos e aleatórios, mínimo 32 caracteres).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
IP_HASH_SECRET=

# Primeiro acesso da moderação: se ainda não existir nenhum moderador, estas
# credenciais criam o administrador no primeiro login. Depois disso, troque a
# senha pelo painel e remova estas variáveis.
MOD_ADMIN_USUARIO=
MOD_ADMIN_SENHA=
